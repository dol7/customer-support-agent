# The Agent SDK authenticates through the `claude` CLI (your Claude Code login).
# Do NOT set ANTHROPIC_API_KEY here — the repo's identity-linked key lacks the
# workspace header the CLI needs, and config.py unsets it on import anyway.

# Optional overrides:
# COORDINATOR_MODEL=claude-sonnet-4-6
# COORDINATOR_SPECIALIST_MODEL=claude-sonnet-4-6
